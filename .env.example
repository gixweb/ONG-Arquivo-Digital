# Arquivo Digital da ONG - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env caso execute em ambiente de homologação ou produção.

# Banco de Dados PostgreSQL (Obrigatório definir senha em produção [SEC-CRED])
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ong_arquivo_digital
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=defina_uma_senha_forte_aqui

# Credenciais de Administrador / Perfis da API (Opcional para override em produção)
SECURITY_SECRETARIA_PASSWORD=defina_uma_senha_para_secretaria
SECURITY_AUDITOR_PASSWORD=defina_uma_senha_para_auditor

# Porta do Servidor Spring Boot
SERVER_PORT=8080

# Profile do Spring (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Configuração do Frontend (URL base da API)
VITE_API_BASE_URL=http://localhost:8080/api/v1
