# Arquivo Digital da ONG - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env caso necessário para overrides locais.

# Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ong_arquivo_digital
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Porta do Servidor Spring Boot
SERVER_PORT=8080

# Profile do Spring (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Configuração do Frontend (URL base da API)
VITE_API_BASE_URL=http://localhost:8080/api/v1
